{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pinident-mobile",
  "compatibility_date": "2026-10-02",
  "main": "./worker.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "id.pinpanion.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/catalog.json", "/model.json", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "pinident-training-prod", "migrations_dir": "migrations" }
  ],
  "env": {
    "dev": {
      "workers_dev": true,
      "d1_databases": [
        { "binding": "DB", "database_name": "pinident-training-dev", "database_id": "5e57f1fd-a385-43b5-a1d5-681986552032", "migrations_dir": "migrations" }
      ],
      "routes": [
        { "pattern": "id.dev.pinpanion.com", "custom_domain": true }
      ]
    }
  }
}
